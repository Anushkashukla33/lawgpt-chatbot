# Self-Learning Chatbot Configuration
# Copy this file to .env and modify as needed

# Server Configuration
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8000
CHATBOT_WORKERS=4

# Database Configuration
CHATBOT_DATABASE_URL=sqlite:///chatbot_data.db
CHATBOT_DATABASE_POOL_SIZE=20

# Model Configuration
CHATBOT_MODEL_NAME=mistral-7b-instruct-v0.1.Q4_0.gguf
CHATBOT_MODEL_PATH=./models/
CHATBOT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Learning Configuration
CHATBOT_LEARNING_RATE=0.001
CHATBOT_BATCH_SIZE=32
CHATBOT_RETRAIN_THRESHOLD=500
CHATBOT_CONFIDENCE_THRESHOLD=0.7

# User Management
CHATBOT_MAX_CONCURRENT_USERS=100
CHATBOT_SESSION_TIMEOUT_MINUTES=30
CHATBOT_CLEANUP_INTERVAL_SECONDS=300

# Paths
CHATBOT_DATA_DIR=./data/
CHATBOT_MODELS_DIR=./models/
CHATBOT_LOGS_DIR=./logs/
CHATBOT_BACKUP_DIR=./backups/

# Logging
CHATBOT_LOG_LEVEL=INFO
CHATBOT_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Performance
CHATBOT_CACHE_SIZE=1000
CHATBOT_MEMORY_LIMIT_MB=2048
CHATBOT_RESPONSE_TIMEOUT_SECONDS=30

# Security (Optional)
CHATBOT_API_KEY=your_api_key_here
CHATBOT_RATE_LIMIT_PER_MINUTE=60
CHATBOT_ENABLE_CORS=true

# Monitoring (Optional)
CHATBOT_ENABLE_METRICS=true
CHATBOT_METRICS_PORT=9090
CHATBOT_ENABLE_HEALTH_CHECKS=true

# Development
CHATBOT_DEBUG=false
CHATBOT_RELOAD=false
CHATBOT_PROFILING=false